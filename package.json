{
  "name": "gorak-frame-designer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "compatibility:fetch": "node scripts/fetch-compatibility.mjs",
    "test:compatibility": "node --test tests/compatibility.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.cjs",
    "verify": "npm test && npm run build",
    "build": "npm run check && vite build && vite build --config vite.library.config.ts && tsc --project tsconfig.library.json",
    "desktop": "npm run build && electron .",
    "test:desktop": "npm run build && electron . --smoke-test"
  },
  "exports": {
    ".": {
      "types": "./dist-library/designer.d.ts",
      "import": "./dist-library/gorak-frame-designer.js"
    }
  },
  "files": [
    "dist-library"
  ],
  "devDependencies": {
    "electron": "44.5.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
